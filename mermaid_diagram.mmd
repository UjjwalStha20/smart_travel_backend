    class Accommodation {
        +id: UUID
        +budget_price: Decimal
        +standard_price: Decimal|null
        +luxury_price: Decimal|null
    }
    class FoodCost {
        +id: UUID
        +budget_price: Decimal
        +standard_price: Decimal|null
        +luxury_price: Decimal|null
    }
    class AttractionType {
        <<enumeration>>
        +temple: "temple"
        +heritage: "heritage"
        +hiking: "hiking"
        +lake: "lake"
        +viewpoint: "viewpoint"
